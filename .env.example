# 🔐 Clave secreta de Django
SECRET_KEY='genera-una-clave-larga-y-unica'

DATABASE_URL='postgresql://usuario:password@host:5432/base_de_datos'

# 🌍 Render / Producción
DJANGO_SETTINGS_MODULE=perfumeria.settings_prod
DEBUG=False
ALLOWED_HOSTS='perfumeria-darcy.onrender.com,127.0.0.1,localhost'
CSRF_TRUSTED_ORIGINS='https://perfumeria-darcy.onrender.com'

# 📧 Email por API HTTPS de Resend (recomendado en Render Free)
EMAIL_TIMEOUT=15
RESEND_API_KEY=re_tu_clave_api_de_resend
# Para producción usa un remitente de un dominio verificado en Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME='D.A.R.C.Y.'
PUBLIC_SITE_URL=https://perfumeria-darcy.onrender.com

# Alternativa exclusiva para desarrollo local con Gmail SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
# EMAIL_FROM_NAME='D.A.R.C.Y.'

# 💰 PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=tu_client_id
PAYPAL_SECRET=tu_secret
PAYPAL_WEBHOOK_ID=tu_webhook_id
# Administrador (solo variables secretas de Render)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=tu-correo@example.com
DJANGO_SUPERUSER_PASSWORD=una-clave-larga-y-unica
