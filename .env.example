# 🔐 Variables de Entorno - Perfumería
# Copiar este archivo a .env y completar los valores

# 🚀 Django
SECRET_KEY=tu-clave-secreta-muy-larga-y-compleja-aqui
DEBUG=False
ALLOWED_HOSTS=perfumeria-tu-dominio.com,www.perfumeria-tu-dominio.com

# 🗄️ Base de Datos PostgreSQL
DB_NAME=perfumeria_prod
DB_USER=postgres
DB_PASSWORD=tu-password-de-db
DB_HOST=localhost
DB_PORT=5432

# 📧 Email para notificaciones
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=noreply@perfumeria.com

# 💰 PayPal (Producción)
PAYPAL_CLIENT_ID=tu-client-id-paypal-produccion
PAYPAL_SECRET=tu-secret-paypal-produccion

# 🗄️ Redis (Caché)
REDIS_URL=redis://127.0.0.1:6379/1

# 🌍 Dominio
DOMAIN=perfumeria-tu-dominio.com
